# ─────────────────────────────────────────────────────────────────────────────
# Yonagi Fansub – environment template
# Copy to `.env.local` for development, or provide via your secret manager in
# production. NEVER commit a filled-in copy of this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public canonical origin. Used for SEO canonicals, OG images, sitemap, cookies.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16+. Use a pooled URL (PgBouncer/Neon/Supabase) for the app and the
# direct URL for migrations.
DATABASE_URL=postgresql://yonagi:yonagi@localhost:5432/yonagi?schema=public&connection_limit=10
DIRECT_DATABASE_URL=postgresql://yonagi:yonagi@localhost:5432/yonagi?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────────
# 32+ random bytes, base64. Generate: `openssl rand -base64 48`
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Sliding session lifetime (days) and absolute maximum lifetime (days).
AUTH_SESSION_TTL_DAYS=14
AUTH_SESSION_ABSOLUTE_TTL_DAYS=90
# Password hashing cost. scrypt N parameter as a power of two exponent (15 = 32768).
AUTH_SCRYPT_LOG_N=15

# ── Rate limiting ────────────────────────────────────────────────────────────
# `memory` is fine for a single instance; use `redis` behind a load balancer.
RATE_LIMIT_DRIVER=memory
REDIS_URL=

# ── Mail ─────────────────────────────────────────────────────────────────────
# `console` prints messages to the log (development). `smtp` uses the settings
# below. Password reset and verification mails are disabled when unset.
MAIL_DRIVER=console
MAIL_FROM="Yonagi Fansub <noreply@yonagifansub.hu>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Media / storage ──────────────────────────────────────────────────────────
# `local` writes to MEDIA_LOCAL_DIR and serves the files from the /uploads route
# — right for development and for a single node with a mounted volume. Use `s3`
# for anything horizontally scaled or on a read-only filesystem.
MEDIA_DRIVER=local
# Where those URLs point. Leave as-is for the local driver; set it to the bucket
# or CDN origin when MEDIA_DRIVER=s3.
MEDIA_PUBLIC_BASE_URL=/uploads
# Local upload directory. Outside `public/` on purpose: Next snapshots that
# folder at build time, so files written afterwards would 404. Mount a volume
# here in production if you stay on the local driver.
MEDIA_LOCAL_DIR=./storage/uploads
# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# S3_ENDPOINT is required for everything except AWS itself.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Optional: error reporting DSN (Sentry-compatible).
ERROR_REPORTING_DSN=

# ── Seed (development only) ──────────────────────────────────────────────────
# Credentials for the initial owner account created by `npm run db:seed`.
SEED_OWNER_EMAIL=owner@yonagifansub.hu
SEED_OWNER_PASSWORD=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret for /api/cron/daily. Without it the endpoint refuses to run.
# Generate: `openssl rand -hex 32`
CRON_SECRET=
